# 🐳 DIXIS DOCKER VPS DEPLOYMENT ENVIRONMENT
# Environment variables for docker-compose.vps.yml
# Based on PostgreSQL production configuration

# Build Information
BUILD_DATE=2025-08-02
GIT_COMMIT=latest
VERSION=2.0.0

# Application Configuration
APP_KEY=base64:aNRU6u09USZW6et0yBCRzMFn5XIfqJ4p97UHdTwlaZg=
APP_URL=https://dixis.io
NEXT_PUBLIC_API_URL=https://dixis.io/api

# Database Configuration (PostgreSQL)
DB_DATABASE=dixis_production
DB_USERNAME=dixis_user
DB_PASSWORD=dixis_secure_vps_2025

# Redis Configuration
REDIS_PASSWORD=redis_secure_vps_2025

# Mail Configuration
MAIL_MAILER=smtp

# MinIO S3-Compatible Storage
MINIO_KEY=dixis_minio_admin_2025
MINIO_SECRET=dixis_minio_secret_key_12345
MINIO_CONSOLE_URL=https://storage.dixis.io

# Elasticsearch Configuration
ELASTIC_PASSWORD=dixis_elastic_secure_2025

# Grafana Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dixis_grafana_admin_2025
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=grafana_user
GRAFANA_DB_PASSWORD=grafana_db_pass_2025

# SSL Configuration
DOMAIN=dixis.io
SSL_EMAIL=admin@dixis.io

# VPS Deployment (used by GitHub Actions)
# These should be set in GitHub Secrets, not in this file
# VPS_HOST=your-vps-ip-address
# VPS_USER=your-vps-username
# VPS_DEPLOY_KEY=your-ssh-private-key

# Monitoring & Alerting
PROMETHEUS_RETENTION_DAYS=30

# Backup Configuration
BACKUP_RETENTION_DAYS=30

# Security Headers
SECURITY_HEADERS_ENABLED=true

# Performance Monitoring
MONITORING_ENABLED=true
METRICS_ENABLED=true

# Greek Market Specific
TIMEZONE=Europe/Athens
CURRENCY=EUR
GREEK_VAT_MAINLAND=0.24
GREEK_VAT_ISLANDS=0.13